# Copy these values into the environment of the dedicated backup service account.
# Never commit the completed connection strings or put them in scheduled-task arguments.

# URL-encode special characters in the database password.
ATTENDANCE_BACKUP_DB_URL=postgresql://postgres.PROJECT_REF:PASSWORD@SESSION_POOLER_HOST:5432/postgres

# Set this only on the recovery workstation, and always point it at a new recovery project.
ATTENDANCE_RESTORE_DB_URL=postgresql://postgres.RECOVERY_PROJECT_REF:PASSWORD@SESSION_POOLER_HOST:5432/postgres
